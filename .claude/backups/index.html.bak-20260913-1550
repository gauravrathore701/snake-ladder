<script src="/socket.io/socket.io.js"></script>
<script>
(function () {
  // ─────────────────────────────────
  //  CONSTANTS
  // ─────────────────────────────────
  const COLORS  = ['#b23a2e', '#2f6f8f', '#b8860b', '#4f7a2a'];
  const NAMES   = ['Player 1', 'Player 2', 'Player 3', 'Player 4'];
  const LADDERS = { 1:38, 4:14, 9:31, 21:42, 28:84, 36:44, 51:67, 71:91 };
  const SNAKES  = { 16:6, 47:26, 49:11, 56:53, 62:19, 64:60, 87:24, 90:48, 93:73, 95:75, 98:78 };

  const PIP_LAYOUTS = {
    1:[4], 2:[0,8], 3:[0,4,8], 4:[0,2,6,8], 5:[0,2,4,6,8], 6:[0,2,3,5,6,8]
  };

  // ─────────────────────────────────
  //  SCREEN MANAGEMENT
  // ─────────────────────────────────
  const screens = {
    modeSelect:   document.getElementById('modeSelect'),
    setup:        document.getElementById('setup'),
    onlineSetup:  document.getElementById('onlineSetup'),
    waitingRoom:  document.getElementById('waitingRoom'),
    game:         document.getElementById('game'),
  };

  function showScreen(name) {
    Object.values(screens).forEach(s => { if (s) s.style.display = 'none'; });
    const el = screens[name];
    if (el) el.style.display = name === 'game' ? 'flex' : (name === 'modeSelect' ? '' : 'block');
    if (name === 'modeSelect') el.style.display = 'flex';
  }

  // ─────────────────────────────────
  //  BOARD RENDERING (shared)
  // ─────────────────────────────────
  const boardEl   = document.getElementById('board');
  const overlayEl = document.getElementById('overlay');

  function cellToRowCol(n) {
    const idx = n - 1;
    const rowFromBottom = Math.floor(idx / 10);
    let col = idx % 10;
    if (rowFromBottom % 2 === 1) col = 9 - col;
    return { row: 9 - rowFromBottom, col };
  }
  function cellCenter(n) {
    const { row, col } = cellToRowCol(n);
    return { x: col * 10 + 5, y: row * 10 + 5 };
  }

  function buildBoard() {
    boardEl.innerHTML = '';
    for (let row = 0; row < 10; row++) {
      for (let col = 0; col < 10; col++) {
        const rfb = 9 - row;
        const n = rfb % 2 === 0 ? rfb * 10 + col + 1 : rfb * 10 + (10 - col);
        const cell = document.createElement('div');
        cell.className = 'cell' + (n % 2 === 0 ? ' even' : '');
        if (n === 1) cell.classList.add('start');
        if (n === 100) cell.classList.add('goal');
        cell.textContent = n;
        boardEl.appendChild(cell);
      }
    }
  }

  function buildOverlay() {
    overlayEl.innerHTML = '';
    Object.entries(LADDERS).forEach(([f, t]) => overlayEl.appendChild(makeLadder(cellCenter(+f), cellCenter(+t))));
    Object.entries(SNAKES).forEach(([f, t]) => overlayEl.appendChild(makeSnake(cellCenter(+f), cellCenter(+t))));
  }

  function makeLadder(a, b) {
    const g = svgEl('g');
    const dx = b.x-a.x, dy = b.y-a.y, len = Math.hypot(dx,dy);
    const nx = -dy/len, ny = dx/len, off = 1.4;
    g.appendChild(svgLine(a.x+nx*off,a.y+ny*off, b.x+nx*off,b.y+ny*off,'#8a6a4b',0.8));
    g.appendChild(svgLine(a.x-nx*off,a.y-ny*off, b.x-nx*off,b.y-ny*off,'#8a6a4b',0.8));
    const rungs = Math.max(3, Math.floor(len/8));
    for (let i = 1; i < rungs; i++) {
      const t = i/rungs, x = a.x+dx*t, y = a.y+dy*t;
      g.appendChild(svgLine(x+nx*off,y+ny*off, x-nx*off,y-ny*off,'#8a6a4b',0.7));
    }
    return g;
  }

  function makeSnake(a, b) {
    const g = svgEl('g');
    const dx = b.x-a.x, dy = b.y-a.y, len = Math.hypot(dx,dy);
    const nx = -dy/len, ny = dx/len, wig = Math.min(6, len/4);
    const m1x = a.x+dx*.33+nx*wig, m1y = a.y+dy*.33+ny*wig;
    const m2x = a.x+dx*.66-nx*wig, m2y = a.y+dy*.66-ny*wig;
    const path = svgEl('path');
    path.setAttribute('d', `M ${a.x} ${a.y} C ${m1x} ${m1y},${m1x} ${m1y},${(a.x+b.x)/2} ${(a.y+b.y)/2} S ${m2x} ${m2y},${b.x} ${b.y}`);
    path.setAttribute('stroke','#9b2d20'); path.setAttribute('stroke-width','1.4');
    path.setAttribute('fill','none'); path.setAttribute('stroke-linecap','round'); path.setAttribute('opacity','0.85');
    g.appendChild(path);
    const head = svgEl('circle');
    head.setAttribute('cx',a.x); head.setAttribute('cy',a.y); head.setAttribute('r','2.2'); head.setAttribute('fill','#9b2d20');
    g.appendChild(head);
    [-0.7,0.7].forEach(off => {
      const eye = svgEl('circle');
      eye.setAttribute('cx',a.x+off); eye.setAttribute('cy',a.y-0.6); eye.setAttribute('r','0.4'); eye.setAttribute('fill','#f7f1e3');
      g.appendChild(eye);
    });
    return g;
  }

  function svgEl(tag) { return document.createElementNS('http://www.w3.org/2000/svg', tag); }
  function svgLine(x1,y1,x2,y2,stroke,width) {
    const l = svgEl('line');
    l.setAttribute('x1',x1); l.setAttribute('y1',y1); l.setAttribute('x2',x2); l.setAttribute('y2',y2);
    l.setAttribute('stroke',stroke); l.setAttribute('stroke-width',width); l.setAttribute('stroke-linecap','round');
    return l;
  }

  // players array used by both modes
  let players = [];

  function renderTokens() {
    const wrap = document.getElementById('board-wrap');
    wrap.querySelectorAll('.token').forEach(t => t.remove());
    const byCell = {};
    players.forEach((p, i) => { const c = p.pos||0; (byCell[c]=byCell[c]||[]).push(i); });
    players.forEach((p, i) => {
      const token = document.createElement('div');
      token.className = 'token';
      token.style.background = p.color;
      let x, y;
      if (!p.pos) { x = -6; y = 100-5; }
      else { const c = cellCenter(p.pos); x = c.x; y = c.y; }
      const group = byCell[p.pos||0];
      const slot = group.indexOf(i);
      if (group.length > 1) {
        const ox = [-1.6,1.6,-1.6,1.6][slot]||0;
        const oy = [-1.6,-1.6,1.6,1.6][slot]||0;
        x += ox; y += oy;
      }
      token.style.left = `calc(${x}% - 1.5%)`;
      token.style.top  = `calc(${y}% - 1.5%)`;
      wrap.appendChild(token);
    });
  }

  const diceEl = document.getElementById('dice');
  function renderDice(value) {
    diceEl.innerHTML = '';
    const on = new Set(PIP_LAYOUTS[value]||[]);
    for (let i = 0; i < 9; i++) {
      const p = document.createElement('div');
      p.className = 'pip' + (on.has(i) ? ' on' : '');
      diceEl.appendChild(p);
    }
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // ─────────────────────────────────
  //  MODE SELECT
  // ─────────────────────────────────
  const urlRoom = new URLSearchParams(location.search).get('room');

  if (urlRoom) {
    // Someone opened an invite link — go straight to join screen
    showScreen('onlineSetup');
    document.getElementById('createSection').style.display = 'none';
    document.getElementById('joinSection').style.display = 'block';
    document.getElementById('joinRoomCode').textContent = `Room: ${urlRoom}`;
    document.getElementById('joinTitle').textContent = 'Join Room';
  } else {
    showScreen('modeSelect');
  }

  document.getElementById('modeSelect').style.display = 'flex';
  document.getElementById('modeSelect').style.flexDirection = 'column';
  document.getElementById('modeSelect').style.alignItems = 'center';

  document.getElementById('localModeBtn').onclick = () => {
    showScreen('setup');
    renderCountButtons();
    renderPlayerList();
  };
  document.getElementById('onlineModeBtn').onclick = () => {
    showScreen('onlineSetup');
    document.getElementById('createSection').style.display = 'block';
    document.getElementById('joinSection').style.display = 'none';
    renderOnlineCountButtons();
  };
  document.getElementById('localBackBtn').onclick = () => showScreen('modeSelect');
  document.getElementById('onlineBackBtn').onclick = () => {
    if (urlRoom) { history.replaceState({}, '', '/'); }
    showScreen('modeSelect');
  };

  // ─────────────────────────────────
  //  LOCAL MODE
  // ─────────────────────────────────
  let current = 0, busy = false, gameOver = false, lastMove = null, isOnline = false;
  let selectedCount = 2;

  const playerCountEl  = document.getElementById('playerCount');
  const playerListEl   = document.getElementById('playerList');
  const turnInfoEl     = document.getElementById('turnInfo');
  const msgEl          = document.getElementById('msg');
  const rollBtn        = document.getElementById('rollBtn');
  const undoBtn        = document.getElementById('undoBtn');

  function renderCountButtons() {
    playerCountEl.innerHTML = '';
    [2,3,4].forEach(n => {
      const b = document.createElement('button');
      b.textContent = n;
      if (n === selectedCount) b.classList.add('sel');
      b.onclick = () => { selectedCount = n; renderCountButtons(); renderPlayerList(); };
      playerCountEl.appendChild(b);
    });
  }

  function renderPlayerList() {
    playerListEl.innerHTML = '';
    for (let i = 0; i < selectedCount; i++) {
      const row = document.createElement('div');
      row.className = 'player-row';
      const dot = document.createElement('div');
      dot.className = 'token-dot';
      dot.style.background = COLORS[i];
      const input = document.createElement('input');
      input.maxLength = 14; input.value = NAMES[i]; input.dataset.idx = i;
      row.appendChild(dot); row.appendChild(input);
      playerListEl.appendChild(row);
    }
  }

  renderCountButtons();
  renderPlayerList();

  document.getElementById('startBtn').onclick = () => {
    players = [];
    playerListEl.querySelectorAll('input').forEach((inp, i) => {
      players.push({ name: inp.value.trim()||NAMES[i], color: COLORS[i], pos: 0 });
    });
    isOnline = false;
    current = 0; busy = false; gameOver = false; lastMove = null;
    startGame();
  };

  function startGame() {
    document.getElementById('winModal').classList.remove('active');
    document.getElementById('leaveBtn').style.display = 'none';
    undoBtn.style.display = '';
    showScreen('game');
    buildBoard(); buildOverlay(); renderTokens();
    updateTurnInfoLocal(); renderDice(1);
    rollBtn.disabled = false; undoBtn.disabled = true;
  }

  function updateTurnInfoLocal() {
    const p = players[current];
    turnInfoEl.innerHTML = `<span class="pname" style="color:${p.color}">${escapeHtml(p.name)}</span>'s turn — square ${p.pos||1}`;
    diceEl.style.background = p.color;
  }
  function setMsg(text) { msgEl.textContent = text||' '; }

  function rollLocal() {
    if (busy||gameOver||isOnline) return;
    busy = true; rollBtn.disabled = true; undoBtn.disabled = true;
    lastMove = { playerIndex: current, prevPos: players[current].pos };
    diceEl.classList.add('rolling');
    let ticks = 0;
    const ticker = setInterval(() => {
      renderDice(1+Math.floor(Math.random()*6)); ticks++;
      if (ticks > 8) {
        clearInterval(ticker); diceEl.classList.remove('rolling');
        const value = 1+Math.floor(Math.random()*6);
        renderDice(value); applyMoveLocal(value);
      }
    }, 60);
  }

  function applyMoveLocal(value) {
    const p = players[current];
    const target = p.pos + value;
    if (target > 100) {
      setMsg(`${p.name} rolled ${value} — needs exact roll.`);
      finishTurnLocal(); return;
    }
    setMsg(`${p.name} rolled ${value}.`);
    let pos = p.pos;
    const steps = [];
    for (let s = 1; s <= value; s++) steps.push(pos+s);
    let i = 0;
    const stepInterval = setInterval(() => {
      p.pos = steps[i]; renderTokens(); i++;
      if (i >= steps.length) { clearInterval(stepInterval); setTimeout(() => resolveLandingLocal(p), 250); }
    }, 180);
  }

  function resolveLandingLocal(p) {
    if (p.pos === 100) { renderTokens(); winLocal(p); return; }
    if (LADDERS[p.pos]) {
      setMsg(`${p.name} climbs a ladder! ${p.pos}→${LADDERS[p.pos]}`);
      p.pos = LADDERS[p.pos]; renderTokens();
      if (p.pos === 100) { setTimeout(() => winLocal(p), 350); return; }
    } else if (SNAKES[p.pos]) {
      setMsg(`${p.name} got bitten! ${p.pos}→${SNAKES[p.pos]}`);
      p.pos = SNAKES[p.pos]; renderTokens();
    }
    finishTurnLocal();
  }

  function finishTurnLocal() {
    setTimeout(() => {
      current = (current+1) % players.length;
      updateTurnInfoLocal(); busy = false;
      rollBtn.disabled = false; undoBtn.disabled = false;
    }, 500);
  }

  function winLocal(p) {
    gameOver = true; undoBtn.disabled = true;
    document.getElementById('winTitle').textContent = `🎉 ${escapeHtml(p.name)} wins!`;
    document.getElementById('winText').textContent = `${escapeHtml(p.name)} reached square 100 and attained Moksha.`;
    document.getElementById('winModal').classList.add('active');
  }

  function undoLocal() {
    if (busy||gameOver||!lastMove||isOnline) return;
    const p = players[lastMove.playerIndex];
    p.pos = lastMove.prevPos;
    current = lastMove.playerIndex; lastMove = null;
    renderTokens(); updateTurnInfoLocal();
    setMsg(`${p.name}'s move undone.`); undoBtn.disabled = true;
  }

  document.getElementById('playAgainBtn').onclick = () => {
    if (isOnline) {
      socket.emit('play-again');
      document.getElementById('winModal').classList.remove('active');
    } else {
      document.getElementById('winModal').classList.remove('active');
      showScreen('setup');
      players.forEach(p => p.pos = 0);
      current = 0; busy = false; gameOver = false; lastMove = null;
      rollBtn.disabled = false; undoBtn.disabled = true;
    }
  };

  document.getElementById('leaveBtn').onclick = () => {
    if (socket) socket.disconnect();
    document.getElementById('winModal').classList.remove('active');
    history.replaceState({}, '', '/');
    showScreen('modeSelect');
  };

  rollBtn.onclick  = () => isOnline ? onlineRoll() : rollLocal();
  diceEl.onclick   = () => isOnline ? onlineRoll() : rollLocal();
  undoBtn.onclick  = undoLocal;

  // ─────────────────────────────────
  //  ONLINE MODE
  // ─────────────────────────────────
  let socket = null;
  let mySlot = -1;
  let onlineState = null;
  let rollingAnim = null;

  let onlineSelectedCount = 2;

  function renderOnlineCountButtons() {
    const el = document.getElementById('onlinePlayerCount');
    el.innerHTML = '';
    [2,3,4].forEach(n => {
      const b = document.createElement('button');
      b.textContent = n;
      if (n === onlineSelectedCount) b.classList.add('sel');
      b.onclick = () => { onlineSelectedCount = n; renderOnlineCountButtons(); };
      el.appendChild(b);
    });
  }

  document.getElementById('createRoomBtn').onclick = () => {
    const name = document.getElementById('hostName').value.trim() || 'Player 1';
    initSocket();
    socket.emit('create-room', { maxPlayers: onlineSelectedCount, name }, (res) => {
      if (!res.ok) return;
      mySlot = res.slot;
      const roomUrl = `${location.origin}?room=${res.roomId}`;
      showWaitingRoom(roomUrl, res.roomId);
    });
  };

  document.getElementById('joinRoomBtn').onclick = () => {
    const name = document.getElementById('guestName').value.trim() || 'Player';
    initSocket();
    socket.emit('join-room', { roomId: urlRoom, name }, (res) => {
      if (res.error) {
        const errEl = document.getElementById('joinError');
        errEl.textContent = res.error; errEl.style.display = '';
        return;
      }
      mySlot = res.slot;
    });
  };

  function initSocket() {
    if (socket) socket.disconnect();
    socket = io();

    socket.on('game-state', (state) => {
      onlineState = state;
      if (state.status === 'waiting') {
        renderWaitingSlots(state);
      } else if (state.status === 'playing' || state.status === 'done') {
        // Game screen already open → update in place; otherwise transition into game
        if (screens.game.style.display === 'flex') {
          applyOnlineState(state);
        } else {
          launchOnlineGame(state);
        }
      }
    });

    socket.on('player-left', ({ name }) => {
      setMsg(`${name} disconnected.`);
    });
  }

  function showWaitingRoom(roomUrl, roomId) {
    showScreen('waitingRoom');
    document.getElementById('inviteUrl').textContent = roomUrl;
    document.getElementById('copyBtn').onclick = () => {
      navigator.clipboard.writeText(roomUrl).then(() => {
        document.getElementById('copyBtn').textContent = 'Copied!';
        setTimeout(() => document.getElementById('copyBtn').textContent = 'Copy', 2000);
      });
    };
    document.getElementById('waitTitle').textContent = `Room: ${roomId}`;
  }

  function renderWaitingSlots(state) {
    const el = document.getElementById('waitingSlots');
    el.innerHTML = '';
    const n = state.maxPlayers;
    for (let i = 0; i < n; i++) {
      const row = document.createElement('div');
      const p = state.players[i];
      row.className = 'slot-row ' + (p ? 'filled' : 'waiting-slot');
      const dot = document.createElement('div');
      dot.className = 'token-dot';
      dot.style.background = COLORS[i];
      const lbl = document.createElement('span');
      lbl.textContent = p ? escapeHtml(p.name) : `Waiting for Player ${i+1}…`;
      if (!p) lbl.classList.add('blinking');
      row.appendChild(dot); row.appendChild(lbl);
      el.appendChild(row);
    }
    const joined = state.players.length;
    document.getElementById('waitingLabel').textContent = `${joined}/${n} players joined`;
  }

  function launchOnlineGame(state) {
    isOnline = true;
    undoBtn.style.display = 'none';
    document.getElementById('leaveBtn').style.display = '';
    players = state.players.map(p => ({ name: p.name, color: p.color, pos: p.pos }));
    showScreen('game');
    buildBoard(); buildOverlay(); renderTokens(); renderDice(1);
    applyOnlineState(state);
  }

  function applyOnlineState(state) {
    players = state.players.map(p => ({ name: p.name, color: p.color, pos: p.pos }));

    if (state.animHint) {
      playOnlineAnimation(state);
    } else {
      renderTokens();
      updateOnlineUI(state);
    }
  }

  function playOnlineAnimation(state) {
    const { slot, roll, fromPos, toPos, jumped } = state.animHint;
    const myDice = (slot === mySlot);

    // Dice animation
    if (!myDice) {
      // Show dice rolling for other player's move
      diceEl.classList.add('rolling');
      diceEl.style.background = COLORS[slot];
    }

    // Store the pre-jump position
    players[slot].pos = fromPos;
    renderTokens();

    let i = 0;
    const steps = [];
    for (let s = 1; s <= roll; s++) {
      const next = fromPos + s;
      if (next <= 100) steps.push(next);
    }

    const stepInterval = setInterval(() => {
      if (!myDice) renderDice(1+Math.floor(Math.random()*6));
      players[slot].pos = steps[i]||toPos;
      renderTokens(); i++;
      if (i >= steps.length) {
        clearInterval(stepInterval);
        diceEl.classList.remove('rolling');
        renderDice(roll);
        diceEl.style.background = state.players[state.current] ? state.players[state.current].color : '#6b4a2f';
        setTimeout(() => {
          if (jumped) {
            players[slot].pos = jumped.to;
            renderTokens();
          }
          updateOnlineUI(state);
        }, 300);
      }
    }, 180);
  }

  function updateOnlineUI(state) {
    players = state.players.map(p => ({ name: p.name, color: p.color, pos: p.pos }));
    renderTokens();

    const cur = state.players[state.current];
    const isMyTurn = state.current === mySlot && state.status === 'playing';
    rollBtn.disabled = !isMyTurn;

    if (cur) {
      diceEl.style.background = cur.color;
      const badge = isMyTurn ? '<span class="your-turn-badge">YOUR TURN</span>' : '';
      turnInfoEl.innerHTML = `<span class="pname" style="color:${cur.color}">${escapeHtml(cur.name)}</span>'s turn — square ${cur.pos||1}${badge}`;
    }

    if (state.lastMsg) setMsg(state.lastMsg);

    if (state.status === 'done') {
      rollBtn.disabled = true;
      setTimeout(() => {
        document.getElementById('winTitle').textContent = `🎉 Winner!`;
        document.getElementById('winText').textContent = state.lastMsg || 'Moksha!';
        document.getElementById('winModal').classList.add('active');
      }, 600);
    }
  }

  function onlineRoll() {
    if (!socket || !isOnline) return;
    if (onlineState && onlineState.current !== mySlot) return;
    if (onlineState && onlineState.status !== 'playing') return;
    rollBtn.disabled = true;
    diceEl.classList.add('rolling');
    let ticks = 0;
    rollingAnim = setInterval(() => {
      renderDice(1+Math.floor(Math.random()*6)); ticks++;
      if (ticks > 10) { clearInterval(rollingAnim); rollingAnim = null; }
    }, 60);
    socket.emit('roll');
  }

  // ─────────────────────────────────
  //  INIT
  // ─────────────────────────────────
  document.getElementById('modeSelect').style.flexDirection = 'column';

  // If opened via invite link, init socket immediately for join flow
  if (urlRoom) {
    initSocket();
    // socket will receive game-state once join-room is emitted (on btn click)
  }

})();
</script>
</body>
</html>
